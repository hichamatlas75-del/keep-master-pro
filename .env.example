# =====================================================================
# KEEP MASTER PRO - ENVIRONMENT CONFIGURATION (PUBLIC CLIENT KEYS ONLY)
# =====================================================================
# IMPORTANT:
# NEVER put Appwrite secret API keys here or in frontend code!
# The Web Client only needs your public Project ID and Endpoint.
# =====================================================================

# Appwrite Cloud Endpoint (Default: https://cloud.appwrite.io/v1)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=keep-master-pro

# Database & Collections IDs (Configured in Appwrite Cloud Console)
VITE_APPWRITE_DATABASE_ID=keep_master_db
VITE_APPWRITE_NOTES_COLLECTION_ID=notes
VITE_APPWRITE_LABELS_COLLECTION_ID=labels
VITE_APPWRITE_REMINDERS_COLLECTION_ID=reminders
VITE_APPWRITE_SHARES_COLLECTION_ID=shares

# Storage Bucket ID (For images, audio, drawing attachments)
VITE_APPWRITE_STORAGE_BUCKET_ID=attachments
